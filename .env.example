# AGT Galactic Trivia secrets (CFG-2, SEC-8). Copy this file to .env; never
# commit .env. Everything that is not a secret goes in config.yaml.

# First-run setup only (AUTH-5): the one-time password the setup screen at
# /admin asks for before it creates the Admin account. It never becomes the
# Admin password and is never stored. At most 1024 characters.
#
# After setup, REMOVE this line and restart (AUTH-6): the server and the
# dashboard keep reminding you while it is still set.
AGT_TRIVIA_SETUP_PASSWORD=
